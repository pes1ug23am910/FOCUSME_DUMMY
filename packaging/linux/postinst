#!/usr/bin/env bash
# ============================================================
# FILE:        postinst
# MODULE:      Phase 4 — Packaging > Linux .deb post-install
# TASK:        T-055
# AUTHOR:      FocusMe Co-Pilot (Claude Opus)
# GENERATED:   Session 4
# PURPOSE:     Post-installation script for FocusMe .deb package.
#              Detects Secure Boot, installs daemon, loads eBPF,
#              configures DNS blocking, enables systemd service.
# USAGE:       Automatically invoked by dpkg after package install.
# ============================================================

set -euo pipefail

# ═══════════════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════════════

readonly DAEMON_BIN="/usr/local/bin/focusme-daemon"
readonly LOADER_BIN="/usr/local/bin/focusme-loader"
readonly SERVICE_FILE="/etc/systemd/system/focusme.service"
readonly UNBOUND_CONF_DIR="/etc/unbound/unbound.conf.d"
readonly RESOLV_CONF="/etc/resolv.conf"
readonly RESOLV_BACKUP="/etc/resolv.conf.focusme.bak"
readonly BPF_PIN_DIR="/sys/fs/bpf/focusme"
readonly LOG_TAG="[FocusMe postinst]"

# ═══════════════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════════════

log_info()  { echo "${LOG_TAG} INFO:  $*"; }
log_warn()  { echo "${LOG_TAG} WARN:  $*" >&2; }
log_error() { echo "${LOG_TAG} ERROR: $*" >&2; }

# ═══════════════════════════════════════════════════════════════
# Step 1: Detect Secure Boot status
# ═══════════════════════════════════════════════════════════════

detect_secure_boot() {
    log_info "Checking Secure Boot status..."

    if command -v mokutil >/dev/null 2>&1; then
        local sb_state
        sb_state=$(mokutil --sb-state 2>/dev/null || true)

        if echo "$sb_state" | grep -qi "enabled"; then
            log_warn "Secure Boot is ENABLED."
            log_warn "eBPF LSM programs require signed BPF bytecode or Secure Boot exemption."
            log_warn "If eBPF loading fails, you may need to:"
            log_warn "  1. Enroll a MOK key:  sudo mokutil --import /path/to/focusme-bpf.der"
            log_warn "  2. Or disable Secure Boot in UEFI/BIOS settings."
            return 1
        else
            log_info "Secure Boot is disabled or not applicable."
            return 0
        fi
    else
        log_info "mokutil not found — cannot determine Secure Boot status."
        log_info "Install mokutil (apt install mokutil) to check Secure Boot."
        return 0
    fi
}

# ═══════════════════════════════════════════════════════════════
# Step 2: Stop existing service (if upgrading)
# ═══════════════════════════════════════════════════════════════

stop_existing_service() {
    if systemctl is-active --quiet focusme 2>/dev/null; then
        log_info "Stopping existing FocusMe service..."
        systemctl stop focusme || log_warn "Failed to stop existing service (may not be running)"
    fi
}

# ═══════════════════════════════════════════════════════════════
# Step 3: Install daemon binary and service file
# ═══════════════════════════════════════════════════════════════

install_daemon() {
    log_info "Installing daemon binary..."

    # Binary is placed by dpkg from the .deb data payload.
    # Verify it exists and is executable.
    if [[ ! -x "${DAEMON_BIN}" ]]; then
        log_error "Daemon binary not found at ${DAEMON_BIN}"
        log_error "Package may be corrupted — try reinstalling."
        exit 1
    fi

    # Verify service file
    if [[ ! -f "${SERVICE_FILE}" ]]; then
        log_error "Service file not found at ${SERVICE_FILE}"
        exit 1
    fi

    # Set correct permissions
    chmod 755 "${DAEMON_BIN}"
    chown root:root "${DAEMON_BIN}"

    log_info "Daemon binary verified at ${DAEMON_BIN}"
}

# ═══════════════════════════════════════════════════════════════
# Step 4: Enable and start systemd service
# ═══════════════════════════════════════════════════════════════

enable_service() {
    log_info "Configuring systemd service..."

    systemctl daemon-reload
    systemctl enable focusme
    systemctl start focusme

    # Wait briefly and verify it started
    sleep 2
    if systemctl is-active --quiet focusme; then
        log_info "FocusMe daemon is running."
    else
        log_warn "FocusMe daemon failed to start. Check: journalctl -u focusme -n 50"
    fi
}

# ═══════════════════════════════════════════════════════════════
# Step 5: Load eBPF LSM program
# ═══════════════════════════════════════════════════════════════

load_ebpf() {
    log_info "Loading eBPF LSM program..."

    if [[ ! -x "${LOADER_BIN}" ]]; then
        log_warn "eBPF loader not found at ${LOADER_BIN}"
        log_warn "eBPF-based enforcement will not be available."
        log_warn "DNS and process-level blocking will still function."
        return 0
    fi

    # Check kernel support for BPF LSM
    if ! grep -q "bpf" /sys/kernel/security/lsm 2>/dev/null; then
        log_warn "Kernel does not have BPF LSM enabled in security modules."
        log_warn "Add 'lsm=lockdown,yama,bpf' to kernel command line (GRUB_CMDLINE_LINUX)."
        log_warn "Then run: sudo update-grub && sudo reboot"
        return 0
    fi

    # Create BPF pin directory
    mkdir -p "${BPF_PIN_DIR}" 2>/dev/null || true

    # Run the loader
    if "${LOADER_BIN}" --pin-dir "${BPF_PIN_DIR}"; then
        log_info "eBPF LSM program loaded successfully."
    else
        log_warn "eBPF loader returned an error."
        log_warn "eBPF enforcement may not be active."

        # Check if Secure Boot is the issue
        detect_secure_boot || true
    fi
}

# ═══════════════════════════════════════════════════════════════
# Step 6: Configure DNS blocking (if Unbound is available)
# ═══════════════════════════════════════════════════════════════

configure_dns() {
    log_info "Checking DNS blocking prerequisites..."

    # DNS blocking is managed by the daemon at runtime.
    # We only ensure Unbound is available and resolv.conf is writable.

    if command -v unbound >/dev/null 2>&1; then
        log_info "Unbound detected — RPZ-based DNS blocking available."

        # Ensure conf.d directory exists
        mkdir -p "${UNBOUND_CONF_DIR}" 2>/dev/null || true

        # Verify Unbound is enabled
        if ! systemctl is-enabled --quiet unbound 2>/dev/null; then
            log_info "Enabling Unbound service..."
            systemctl enable unbound 2>/dev/null || log_warn "Failed to enable Unbound"
            systemctl start unbound 2>/dev/null || log_warn "Failed to start Unbound"
        fi
    else
        log_info "Unbound not installed — daemon will use /etc/hosts fallback."
        log_info "For better DNS blocking, install Unbound: sudo apt install unbound"
    fi

    # Backup resolv.conf if not already backed up
    if [[ -f "${RESOLV_CONF}" ]] && [[ ! -f "${RESOLV_BACKUP}" ]]; then
        cp "${RESOLV_CONF}" "${RESOLV_BACKUP}"
        log_info "Backed up resolv.conf to ${RESOLV_BACKUP}"
    fi
}

# ═══════════════════════════════════════════════════════════════
# Step 7: Print post-install instructions
# ═══════════════════════════════════════════════════════════════

print_instructions() {
    echo ""
    echo "═══════════════════════════════════════════════════════"
    echo "  FocusMe installed successfully!"
    echo "═══════════════════════════════════════════════════════"
    echo ""
    echo "  Service status:  systemctl status focusme"
    echo "  View logs:       journalctl -u focusme -f"
    echo "  Restart:         sudo systemctl restart focusme"
    echo ""
    echo "  Browser extension:"
    echo "    Install the FocusMe extension from the Chrome Web Store"
    echo "    or load the unpacked extension from /usr/share/focusme/extension/"
    echo ""

    # eBPF kernel parameter reminder
    if ! grep -q "bpf" /sys/kernel/security/lsm 2>/dev/null; then
        echo "  ⚠  eBPF LSM not enabled in kernel."
        echo "     Add to /etc/default/grub:"
        echo "       GRUB_CMDLINE_LINUX=\"lsm=lockdown,yama,bpf\""
        echo "     Then: sudo update-grub && sudo reboot"
        echo ""
    fi

    echo "═══════════════════════════════════════════════════════"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# Main — dpkg calls postinst with "configure" argument
# ═══════════════════════════════════════════════════════════════

case "${1:-}" in
    configure)
        log_info "FocusMe post-install starting..."

        detect_secure_boot || true    # Non-fatal
        stop_existing_service         # Stop if upgrading
        install_daemon                # Verify binary
        enable_service                # systemd enable + start
        load_ebpf                     # eBPF LSM (non-fatal)
        configure_dns                 # DNS blocking setup
        print_instructions            # User guidance

        log_info "FocusMe post-install complete."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        log_info "Post-install abort action: ${1}"
        ;;

    *)
        log_info "Post-install called with unknown argument: ${1:-}"
        ;;
esac

exit 0
