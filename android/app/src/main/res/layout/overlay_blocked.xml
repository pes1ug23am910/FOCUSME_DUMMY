<?xml version="1.0" encoding="utf-8"?>
<!--
    FILE:        overlay_blocked.xml
    MODULE:      Layer 1 — Enforcement Engine > Android Blocked Overlay
    TASK:        T-041 (implementation — Session 4)
    PLATFORM:    android
    AUTHOR:      FocusMe Co-Pilot (Claude Opus)
    GENERATED:   Phase 3, AccessibilityService fullscreen block overlay
    DEPENDENCIES: ConstraintLayout (androidx.constraintlayout:constraintlayout)
    TEST COVERAGE: Test: overlay renders with app name and Go Home button
    KNOWN LIMITATIONS: Requires SYSTEM_ALERT_WINDOW permission on Android 6+.
                       TYPE_APPLICATION_OVERLAY on Android 8+.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E61E1E1E"
    android:padding="32dp"
    tools:context=".service.FocusMeAccessibilityService">

    <!-- FocusMe logo / icon placeholder -->
    <TextView
        android:id="@+id/focusme_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="72sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/blocked_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.35" />

    <!-- "BLOCKED" label -->
    <TextView
        android:id="@+id/blocked_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="BLOCKED"
        android:textSize="32sp"
        android:textColor="#FFEF5350"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/focusme_logo"
        app:layout_constraintBottom_toTopOf="@id/app_name_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Blocked app name (set dynamically) -->
    <TextView
        android:id="@+id/app_name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="This app is blocked by FocusMe"
        android:textSize="18sp"
        android:textColor="#B3FFFFFF"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        tools:text="com.example.blockedapp"
        app:layout_constraintTop_toBottomOf="@id/blocked_label"
        app:layout_constraintBottom_toTopOf="@id/explanation_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Explanation text -->
    <TextView
        android:id="@+id/explanation_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:text="This app is restricted by your Focus Plan.\nStay focused and come back later."
        android:textSize="14sp"
        android:textColor="#80FFFFFF"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/app_name_label"
        app:layout_constraintBottom_toTopOf="@id/go_home_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Go Home" button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/go_home_button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="Go Home"
        android:textSize="16sp"
        android:textColor="#FF1E1E1E"
        android:textAllCaps="false"
        app:backgroundTint="#FFFFFFFF"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/explanation_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.6" />

</androidx.constraintlayout.widget.ConstraintLayout>
