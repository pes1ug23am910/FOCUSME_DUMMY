# ============================================================
# FILE:        .env.example
# MODULE:      Phase 5 — Cloud Backend > Configuration
# TASK:        T-060
# AUTHOR:      FocusMe Co-Pilot (Claude Opus)
# GENERATED:   Session 7
# PURPOSE:     Template for backend environment variables
# ============================================================
#
# Copy to .env and fill in values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://focusme:focusme_dev_password@localhost:5432/focusme

# PostgreSQL container settings (used by docker-compose)
POSTGRES_DB=focusme
POSTGRES_USER=focusme
POSTGRES_PASSWORD=focusme_dev_password
POSTGRES_PORT=5432

# ── Authentication ───────────────────────────────────────────

# JWT signing secret — MUST be a strong random string in production.
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_64

# ── Server ───────────────────────────────────────────────────

# Port for the backend HTTP server
PORT=8080

# Rust log levels (tracing/env_filter)
RUST_LOG=focusme_backend=debug,tower_http=debug

# ── Future Configuration (Phase 6+) ─────────────────────────

# PostHog analytics — leave empty or omit to disable analytics (no-op mode)
POSTHOG_API_KEY=phc_your_key_here

# SMTP server for email verification and invite delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Frontend URL for CORS origin restriction
# FRONTEND_URL=https://app.focusme.io

# Push notification service (FCM / APNs)
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
