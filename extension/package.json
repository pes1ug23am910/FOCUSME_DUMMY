{
  "name": "focusme-browser-extension",
  "version": "0.1.0",
  "description": "FocusMe browser extension — intercepts URL navigation and enforces blocking rules via the daemon IPC",
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode production",
    "build:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode production",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "package:chrome": "npm run build:chrome && web-ext build -s dist/chrome -a artifacts/chrome",
    "package:firefox": "npm run build:firefox && web-ext build -s dist/firefox -a artifacts/firefox"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.25.0",
    "@anthropic-ai/tool-use": "^0.25.0",
    "@types/chrome": "^0.0.268",
    "@types/webextension-polyfill": "^0.12.1",
    "cross-env": "^7.0.3",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^10.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "web-ext": "^8.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
